# Copy this file to .env.local and fill in your real values from
# Supabase -> Settings -> API Keys. Only the ANON/PUBLISHABLE key goes
# here — never the service_role/secret key, since this runs in the browser.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
